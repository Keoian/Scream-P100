+// Deterministic, so the residency choice and the loader agree
+std::vector<int> plan_pools(const std::vector<std::pair<size_t, size_t>>& sz, int max_pools, std::vector<std::pair<size_t, size_t>>& pad) {
+    struct G {
+        size_t gu, dn;
+        std::vector<int> layers;
+    };
+    std::vector<G> g;
+    for (int l = 0; l < (int) sz.size(); ++l) {
+        auto it = std::find_if(g.begin(), g.end(), [&](const G& x) { return x.gu == sz[(size_t) l].first && x.dn == sz[(size_t) l].second; });
+        if (it == g.end()) g.push_back(G{sz[(size_t) l].first, sz[(size_t) l].second, {}}), it = g.end() - 1;
+        it->layers.push_back(l);
+    }
+    auto waste = [&](size_t gu, size_t dn, const std::vector<int>& ls) {
+        size_t w = 0;
