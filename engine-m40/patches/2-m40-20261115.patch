+// FNX_QSA_DUMP=<dir> (a diagnostic; it waits for the stream, so not for measuring): every FNX_QSA_DUMP_EVERY-th (113) selection of
+// a prompt group on card 0 (64 rows or more) writes the group's scores to <dir>/g<n>.bin, FNX_QSA_DUMP_MAX (26) files at most:
+// four ints (the rows, the blocks a row, the first row's position, max_pools), then the rows' scores.
+static void qsa_dump_scores(const float* scores, int max_pools, const int* pos0, int T, int card, cudaStream_t s) {
+    static const char* const dir = std::getenv("FNX_QSA_DUMP");
+    if (!dir || !*dir || card != 0 || T < 64) return;
+    static const int every = std::max(1, (int) env_int("FNX_QSA_DUMP_EVERY", 113)), most = (int) env_int("FNX_QSA_DUMP_MAX", 26);
+    static int calls = 0, files = 0;
+    if (calls++ % every != 0 || files >= most) return;
+    int p0 = 0;
+    if (cudaStreamSynchronize(s) != cudaSuccess || cudaMemcpy(&p0, pos0, sizeof(int), cudaMemcpyDeviceToHost) != cudaSuccess) return;
+    const int W = std::min(max_pools, (p0 + T) / QSA_POOL);
+    if (W <= 0) return;
+    std::vector<float> h((size_t) T * W);
+    if (cudaMemcpy2D(h.data(), (size_t) W * sizeof(float), scores, (size_t) max_pools * sizeof(float), (size_t) W * sizeof(float),
+                     (size_t) T, cudaMemcpyDeviceToHost) != cudaSuccess)
+        return;
+    char path[600];
+    std::snprintf(path, sizeof path, "%s/g%03d.bin", dir, files);
+    FILE* f = std::fopen(path, "wb");
+    if (!f) return;
+    const int head[4] = {T, W, p0, max_pools};
+    std::fwrite(head, sizeof(int), 4, f);
+    std::fwrite(h.data(), sizeof(float), h.size(), f);
+    std::fclose(f);
+    ++files;
+}
+
+// FNX_QSA_SEL=1 (the P100 port): k_idx_select_c for a window's or a prompt group's rows instead of k_idx_select (qsa.cuh: a bound,
+// the candidates no less than it, k_idx_select's steps on those alone; the same cells and counts). The same grid, a block a row.
+static void qsa_select_rows(const float* scores, int* cells, int* n_cells, int max_pools, const int* pos0, int T, int card, cudaStream_t s) {
+    qsa_dump_scores(scores, max_pools, pos0, T, card, s);
+    static const bool on = env_int("FNX_QSA_SEL", 0) != 0;
+    if (on) k_idx_select_c<2048><<<T, QSA_SEL_THREADS, 0, s>>>(scores, cells, n_cells, max_pools, pos0, card);
+    else k_idx_select<<<T, QSA_SEL_THREADS, 0, s>>>(scores, cells, n_cells, max_pools, pos0, card, LaneRows{});
+}
+
+// FNX_QSA_TILE=1 (the P100 port): k_idx_score_a for a window's or a prompt group's rows instead of k_idx_score (qsa.cuh: a thread
+// scores a tile of rows by 2 pools; the same scores bit for bit). The grid is a count of blocks from T and the context only (a
+// decode window's launches are captured per T; the kernel picks the tile from the position itself): a power of two, a block a
